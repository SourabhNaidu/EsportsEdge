{
  "name": "esportsedge",
  "version": "1.0.0",
  "description": "Valorant-first esports prediction and analytics platform.",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/src/server.js",
    "server:start": "node server/src/server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test": "jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SourabhNaidu/EsportsEdge.git"
  },
  "keywords": [
    "esports",
    "valorant",
    "predictions",
    "analytics"
  ],
  "author": "Sourabh Naidu",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SourabhNaidu/EsportsEdge/issues"
  },
  "homepage": "https://github.com/SourabhNaidu/EsportsEdge#readme",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  }
}
